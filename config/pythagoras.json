       {

  "$schema": "pythagoras.schema.json",

  "version": 1,

  "settings": {
    "section_style": "tab",
    "reuse_cards": true,
    "max_card_height": "450px",
    "max_dupl_cards": 10
  },

  "layout": [
    {
      "section": "Data prep",
      "cards": [
        {"module": "DataImport"},
        {"module": "DataTabulation"},
        {"module": "RoleAssignment"},
        {"module": "VarModify"},
        {"module": "VarDissimilar"},
        {"module": "MissPlaceholders"},
        {"module": "MissInformative"},
        {"module": "MissRules"},
        {"module": "MissType"}
      ]
    },

    {
      "section": "Missing values",
      "cards": [
        {"module": "DataPlaceholders"},
        {"module": "DataTabulation"}
      ]
    }
  ]
}