{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Pythagoras: nightly test suite",
            "type": "process",
            "command": "/usr/bin/caffeinate",
            "args": [
                "-i",
                "${workspaceFolder}/.venv/bin/python",
                "${workspaceFolder}/scripts/nightly_tests.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}
