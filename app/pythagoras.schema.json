{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "$id": "https://raw.githubusercontent.com/nhward60/pythagoras/main/config/pythagoras.schema.json",

  "title": "Pythagoras Configuration",

  "type": "object",

  "properties": {
    "$schema": {
      "type": "string"
    },

    "version": {
      "type": "integer",
      "enum": [1, 2],
      "description": "Version 1 bookmarks remain readable and are migrated in memory to version 2."
    },

    "active_section": {
      "type": "string",
      "minLength": 1
    },

    "bookmark": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "filename": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.pythagoras\\.json$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["filename", "created_at"]
    },

    "settings": {
      "type": "object",
      "properties": {
        "section_style": {
          "type": "string",
          "enum": ["tab", "accordion"]
        },

        "show_start": {
          "type": "boolean"
        },

        "restore_last_active_section": {
          "type": "boolean",
          "default": false,
          "description": "Restore the bookmarked active section; otherwise open the first workflow section."
        },

        "reuse_cards": {
          "type": "boolean"
        },

        "max_card_height": {
          "type": "string"
        },

        "max_dupl_cards": {
          "type": "integer"
        }
      },

      "required": [
        "section_style",
        "reuse_cards",
        "max_card_height",
        "max_dupl_cards"
      ]
    },

    "layout": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "section": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9]+(?: [A-Za-z0-9]+)*$",
            "description": "Section names may contain letters, numbers and single spaces only."
          },

          "cards": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "module": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },

                "state": {
                  "$ref": "#/$defs/cardState"
                }
              },
              "required": ["module"]
            }
          }
        },
        "required": ["section", "cards"]
      }
    }
  },

  "required": ["version", "settings", "layout"],

  "$defs": {
    "cardState": {
      "type": "object",
      "description": "Opaque JSON-compatible state owned and validated by the card that produced it."
    }
  }
}
