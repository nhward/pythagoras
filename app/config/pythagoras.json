       {

  "$schema": "pythagoras.schema.json",

  "version": 1,

  "settings": {
    "section_style": "tab",
    "show_start": false,
    "reuse_cards": true,
    "max_card_height": "450px",
    "max_dupl_cards": 10
  },

  "layout": [
    {
      "section": "Data prep",
      "cards": [
        {"module": "data_import"},
        {"module": "data_tabulation"},
        {"module": "role_assignment"},
        {"module": "var_modify"},
        {"module": "var_dissimilar"},
        {"module": "data_tabulation"}
      ]
    },

    {
      "section": "Missing values",
      "cards": [
        {"module": "miss_placeholders"},
        {"module": "miss_informative"},
        {"module": "miss_map"},
        {"module": "miss_sets"},
        {"module": "miss_rules"},
        {"module": "miss_type"},
        {"module": "miss_impute"}
      ]
    },

    {
      "section": "Observations",
      "cards": [
        {"module": "obs_duplicates"},
        {"module": "data_tabulation"}
      ]
    },

    {
      "section": "System",
      "cards": [
        {"module": "sys_configuration"},
        {"module": "system_log"}
      ]
    }
  ]
}
