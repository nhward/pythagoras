{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "$id": "https://raw.githubusercontent.com/nhward60/pythagoras/main/config/pythagoras.schema.json",

  "title": "Pythagoras Configuration",

  "type": "object",

  "properties": {
    "$schema": {
      "type": "string"
    },

    "version": {
      "type": "integer",
      "minimum": 1
    },

    "settings": {
      "type": "object",
      "properties": {
        "section_style": {
          "type": "string",
          "enum": ["tab", "accordion"]
        },

        "show_start": {
          "type": "boolean"
        },

        "reuse_cards": {
          "type": "boolean"
        },

        "max_card_height": {
          "type": "string"
        },

        "max_dupl_cards": {
          "type": "integer"
        }
      },

      "required": [
        "section_style",
        "reuse_cards",
        "max_card_height",
        "max_dupl_cards"
      ]
    },

    "layout": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "section": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9]+(?: [A-Za-z0-9]+)*$",
            "description": "Section names may contain letters, numbers and single spaces only."
          },

          "cards": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "module": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },

                "state": {
                  "$ref": "#/$defs/cardState"
                }
              },
              "required": ["module"]
            }
          }
        },
        "required": ["section", "cards"]
      }
    }
  },

  "required": ["version", "settings", "layout"],

  "$defs": {
    "nullableString": {
      "type": ["string", "null"]
    },

    "uploadedFile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "size": {"type": "integer", "minimum": 0},
        "type": {"type": "string"},
        "datapath": {"type": "string"}
      },
      "required": ["name", "size", "type", "datapath"]
    },

    "dataImportInputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Navset": {
          "type": "string",
          "enum": ["File based", "Dataset based", "Web based", "UC Irvine"]
        },
        "ServerFile": {
          "type": ["array", "null"],
          "items": {"$ref": "#/$defs/uploadedFile"}
        },
        "LocalFilePath": {"$ref": "#/$defs/nullableString"},
        "FName": {"$ref": "#/$defs/nullableString"},
        "Dataset": {"$ref": "#/$defs/nullableString"},
        "DName": {"$ref": "#/$defs/nullableString"},
        "Url": {"$ref": "#/$defs/nullableString"},
        "UName": {"$ref": "#/$defs/nullableString"},
        "UciDataset": {"$ref": "#/$defs/nullableString"},
        "IName": {"$ref": "#/$defs/nullableString"},
        "Separator": {"$ref": "#/$defs/nullableString"},
        "Sheet": {"type": ["number", "null"]}
      }
    },

    "cardState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputs": {"$ref": "#/$defs/dataImportInputs"},
        "last_committed_tab": {
          "type": ["string", "null"],
          "enum": [
            "File based",
            "Dataset based",
            "Web based",
            "UC Irvine",
            null
          ]
        }
      },
      "required": ["inputs", "last_committed_tab"]
    }
  }
}
