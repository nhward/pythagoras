{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "$id": "https://raw.githubusercontent.com/nhward60/pythagoras/main/config/pythagoras.schema.json",

  "title": "Pythagoras Configuration",

  "type": "object",

  "properties": {
    "$schema": {
      "type": "string"
    },

    "version": {
      "type": "integer",
      "minimum": 1
    },

    "settings": {
      "type": "object",
      "properties": {
        "section_style": {
          "type": "string",
          "enum": ["tab", "accordion"]
        },

        "show_start": {
          "type": "boolean"
        },

        "reuse_cards": {
          "type": "boolean"
        },

        "max_card_height": {
          "type": "string"
        },

        "max_dupl_cards": {
          "type": "integer"
        }
      },

      "required": [
        "section_style",
        "reuse_cards",
        "max_card_height",
        "max_dupl_cards"
      ]
    },

    "layout": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "section": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9]+(?: [A-Za-z0-9]+)*$",
            "description": "Section names may contain letters, numbers and single spaces only."
          },

          "cards": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "module": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                }
              },
              "required": ["module"]
            }
          }
        },
        "required": ["section", "cards"]
      }
    }
  },

  "required": ["version", "settings", "layout"]
}
