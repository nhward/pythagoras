{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pythagoras.local/schemas/estimator-capabilities-1.4.0.json",
  "title": "Versioned estimator capability catalogue",
  "type": "object",
  "required": [
    "schema_version",
    "catalogue_version",
    "generated_at",
    "python_version",
    "scope",
    "packages",
    "semantics",
    "estimators",
    "profiles",
    "discovery_issues",
    "specialists"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.4.0"
    },
    "catalogue_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generated_at": {
      "type": "string"
    },
    "python_version": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "packages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "version",
          "status"
        ],
        "properties": {
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "inspected",
              "not_installed",
              "import_failed"
            ]
          },
          "module_scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "semantics": {
      "type": "object"
    },
    "discovery_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "module",
          "error"
        ]
      }
    },
    "estimators": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/estimator"
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "specialists": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/specialist"
      }
    }
  },
  "$defs": {
    "estimator": {
      "type": "object",
      "required": [
        "id",
        "implementation",
        "package",
        "package_version",
        "kinds",
        "constructor",
        "default_tags",
        "tag_error",
        "tag_evidence",
        "methods",
        "weighting",
        "incremental_api_present",
        "achievable_profile_ids",
        "unreviewed_capabilities",
        "taxonomy",
        "outputs",
        "output_review"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "implementation": {
          "type": "string"
        },
        "package": {
          "type": "string"
        },
        "package_version": {
          "type": "string"
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constructor": {
          "type": "object",
          "required": [
            "signature",
            "required_arguments"
          ]
        },
        "default_tags": {
          "type": [
            "object",
            "null"
          ]
        },
        "tag_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "tag_evidence": {
          "enum": [
            "installed_instance_introspection",
            "unavailable"
          ]
        },
        "methods": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "weighting": {
          "type": "object"
        },
        "incremental_api_present": {
          "type": "boolean"
        },
        "achievable_profile_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unreviewed_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "superseded_by": {
          "$ref": "#/$defs/supersession"
        },
        "purpose": {
          "enum": [
            "model_candidate",
            "benchmark_only"
          ]
        },
        "purpose_reason": {
          "type": "string"
        },
        "taxonomy": {
          "$ref": "#/$defs/taxonomy"
        },
        "output_review": {
          "$ref": "#/$defs/output_review"
        },
        "outputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "not": {
              "const": "class_prediction"
            }
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "required": [
        "id",
        "estimator",
        "label",
        "task",
        "reviewed_package_version",
        "construction",
        "capabilities",
        "conditions",
        "weighting",
        "scalability",
        "recipe",
        "sources",
        "probe",
        "subjective_assessment",
        "inspected_package_version",
        "version_match",
        "validation",
        "reviewed_dependencies",
        "inspected_dependencies",
        "taxonomy",
        "outputs",
        "output_review"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "estimator": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "task": {
          "enum": [
            "classifier",
            "regressor",
            "transformer",
            "sampler"
          ]
        },
        "reviewed_package_version": {
          "type": "string"
        },
        "inspected_package_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "version_match": {
          "type": "boolean"
        },
        "construction": {
          "type": "object",
          "required": [
            "parameters",
            "preparation",
            "wrapper"
          ],
          "properties": {
            "parameters": {
              "type": "object"
            },
            "preparation": {
              "enum": [
                "numeric",
                "pandas_categories",
                "catboost_strings",
                "impute_onehot",
                "categorical_complete"
              ]
            },
            "wrapper": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "capabilities": {
          "type": "object",
          "required": [
            "numeric_predictors",
            "categorical_predictors",
            "missing_numeric_predictors",
            "missing_categorical_predictors",
            "sparse_input",
            "sample_weight_fit",
            "incremental_training"
          ],
          "additionalProperties": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "weighting": {
          "type": "object"
        },
        "scalability": {
          "type": "object"
        },
        "recipe": {
          "type": "object"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^https://"
          }
        },
        "probe": {
          "type": "object"
        },
        "subjective_assessment": {
          "type": "object",
          "required": [
            "kind",
            "overall",
            "confidence",
            "rationale",
            "assumptions"
          ],
          "properties": {
            "kind": {
              "const": "expert_judgement_not_benchmark"
            }
          }
        },
        "validation": {
          "enum": [
            "not_run",
            "passed",
            "failed",
            "version_mismatch",
            "unavailable"
          ]
        },
        "validation_details": {
          "type": "object"
        },
        "reviewed_dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "inspected_dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "structure": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "not": {
              "const": "class_prediction"
            }
          }
        },
        "taxonomy": {
          "$ref": "#/$defs/taxonomy"
        },
        "output_review": {
          "$ref": "#/$defs/output_review"
        }
      }
    },
    "specialist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "estimator",
        "package",
        "task",
        "documentation_version",
        "reviewed_on",
        "evidence",
        "validation",
        "integration",
        "structure",
        "outputs",
        "requirements",
        "parameters",
        "steps",
        "assumptions",
        "capabilities",
        "subjective_assessment",
        "sources",
        "taxonomy",
        "output_review"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "estimator": {
          "type": "string"
        },
        "package": {
          "type": "string"
        },
        "task": {
          "enum": [
            "regression",
            "ordinal",
            "survival",
            "forecasting",
            "classification"
          ]
        },
        "documentation_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_on": {
          "type": "string"
        },
        "evidence": {
          "const": "official_documentation"
        },
        "validation": {
          "const": "not_run"
        },
        "integration": {
          "const": "adapter_required"
        },
        "structure": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "not": {
              "const": "class_prediction"
            }
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parameters": {
          "type": "object"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "subjective_assessment": {
          "type": "object"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "taxonomy": {
          "$ref": "#/$defs/taxonomy"
        },
        "output_review": {
          "$ref": "#/$defs/output_review"
        }
      }
    },
    "supersession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "relationship",
        "configuration",
        "reason",
        "caveats",
        "sources",
        "reviewed_on"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "relationship": {
          "enum": [
            "configured_special_case",
            "objective_family",
            "upstream_replacement"
          ]
        },
        "configuration": {
          "type": "object"
        },
        "reason": {
          "type": "string"
        },
        "caveats": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^https://"
          }
        },
        "reviewed_on": {
          "type": "string"
        }
      }
    },
    "taxonomy_attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values",
        "status",
        "note"
      ],
      "properties": {
        "values": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": [
            "reviewed",
            "depends_on_configuration",
            "unreviewed",
            "not_applicable",
            "deferred"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unreviewed",
                  "not_applicable",
                  "deferred"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "values": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "reviewed"
              }
            }
          },
          "then": {
            "properties": {
              "values": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core_mechanism",
        "composition",
        "fitting_criterion",
        "transparency",
        "capacity_growth",
        "sources",
        "reviewed_on",
        "learning_strategy"
      ],
      "properties": {
        "core_mechanism": {
          "allOf": [
            {
              "$ref": "#/$defs/taxonomy_attribute"
            },
            {
              "properties": {
                "values": {
                  "items": {
                    "enum": [
                      "baseline",
                      "distribution",
                      "empirical_distribution",
                      "generalized_linear",
                      "kernel",
                      "neighborhood",
                      "neural_network",
                      "prototype",
                      "rule",
                      "spatial",
                      "state_space",
                      "symbolic",
                      "tree"
                    ]
                  }
                }
              }
            }
          ]
        },
        "composition": {
          "allOf": [
            {
              "$ref": "#/$defs/taxonomy_attribute"
            },
            {
              "properties": {
                "values": {
                  "items": {
                    "enum": [
                      "bagging",
                      "boosted_feature_construction",
                      "boosting",
                      "calibration",
                      "consensus_fitting",
                      "fold_averaging",
                      "forecast_reduction",
                      "local_aggregation",
                      "mixed_effects",
                      "mixture",
                      "random_feature_selection",
                      "randomized_averaging",
                      "resampled_averaging",
                      "resampling",
                      "residual_forest",
                      "rule_aggregation",
                      "rule_routing",
                      "single",
                      "stacking",
                      "state_space",
                      "target_transformation",
                      "tree_routing",
                      "voting_averaging"
                    ]
                  }
                }
              }
            }
          ]
        },
        "fitting_criterion": {
          "$ref": "#/$defs/taxonomy_attribute"
        },
        "transparency": {
          "allOf": [
            {
              "$ref": "#/$defs/taxonomy_attribute"
            },
            {
              "properties": {
                "values": {
                  "items": {
                    "enum": [
                      "conditional",
                      "usually_opaque",
                      "usually_transparent"
                    ]
                  }
                }
              }
            }
          ]
        },
        "capacity_growth": {
          "allOf": [
            {
              "$ref": "#/$defs/taxonomy_attribute"
            },
            {
              "properties": {
                "status": {
                  "const": "deferred"
                }
              }
            }
          ]
        },
        "sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https://"
          }
        },
        "reviewed_on": {
          "type": [
            "string",
            "null"
          ]
        },
        "learning_strategy": {
          "allOf": [
            {
              "$ref": "#/$defs/taxonomy_attribute"
            },
            {
              "properties": {
                "values": {
                  "maxItems": 1,
                  "items": {
                    "enum": [
                      "eager",
                      "lazy",
                      "hybrid"
                    ]
                  }
                }
              }
            }
          ]
        }
      }
    },
    "output_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "note",
        "sources"
      ],
      "properties": {
        "status": {
          "enum": [
            "reviewed",
            "depends_on_configuration",
            "unreviewed",
            "not_applicable"
          ]
        },
        "note": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    }
  }
}
